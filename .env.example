# Telegram bot token from @BotFather
BOT_TOKEN=

# Anthropic API key
ANTHROPIC_API_KEY=

# Model used for article generation and review
MODEL=claude-sonnet-4-6

# Path to the SQLite DB file (the docker-compose volume mounts /data)
DB_PATH=/data/lector.db

# Secret used to sign session JWTs — use a long random string in production
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_SECONDS=3600

# Per-user daily rate limits (protect against runaway token spend)
DAILY_ARTICLE_LIMIT=10
DAILY_REVIEW_LIMIT=20

# Comma-separated Telegram user IDs allowed to read GET /api/admin/usage
ADMIN_TG_IDS=

# Public HTTPS URL of the deployed Mini App (used for the bot's web_app buttons).
# Must be HTTPS — Telegram rejects http:// web_app URLs.
WEBAPP_URL=https://lector.example.com

PORT=3000
LOG_LEVEL=info
NODE_ENV=production
